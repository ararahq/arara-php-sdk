{
    "name": "ararahq/sdk",
    "description": "PHP SDK for the AraraHQ API. AraraHQ: WhatsApp for Brazilian companies. Team inbox with AI, campaigns and systems connected through the API.",
    "keywords": [
        "ararahq",
        "whatsapp",
        "whatsapp-business",
        "arara",
        "sdk",
        "api",
        "messaging",
        "brazil"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Arara\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arara\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=8",
        "format": "php-cs-fixer fix",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
